# FIREBASE CLIENT CONFIGURATION
# Provisioned via Firebase Firestore & Authentication setup
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# META / INSTAGRAM GRAPH API CREDENTIALS
# Official Instagram OAuth via Meta for Developers App (Graph API)
INSTAGRAM_CLIENT_ID="your_meta_app_id"
INSTAGRAM_CLIENT_SECRET="your_meta_app_secret"
INSTAGRAM_REDIRECT_URI="https://your-domain.com/api/instagram/callback"

# PAYMENT GATEWAY (Stripe)
# Used for real checkout sessions and webhook verification
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
